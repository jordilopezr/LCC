# Maintainer: Jordi Lopez Reyes <aim@jordilopezr.com>
pkgname=lightweight-cloud-connector-bin
pkgver=27H1.preview.20261012.50
# Nombre de la release en GitHub (tag v27H1-preview.20261012.50, assets
# *_27H1-preview.20261012.50_*). pkgver no admite guiones, así que usa puntos;
# el tag y los ficheros, la forma de los scripts de release.
_relver=27H1-preview.20261012.50
pkgrel=1
pkgdesc="Native Google Cloud IAP Connector for Linux"
arch=('x86_64')
url="https://github.com/jordilopezr/LCC"
license=('GPL-3.0-or-later')
depends=('gtk3' 'remmina' 'freerdp' 'krdc' 'tigervnc')
provides=('lightweight-cloud-connector')
conflicts=('lightweight-cloud-connector')

source=("${url}/releases/download/v${_relver}/lightweight-cloud-connector_${_relver}_amd64.tar.gz")
sha256sums=('SKIP') # En producción, reemplaza SKIP por el hash sha256 del tar.gz

package() {
    cd "${srcdir}/lightweight-cloud-connector"

    # Instalar binarios y librerías
    install -d "${pkgdir}/opt/lightweight-cloud-connector"
    cp -r * "${pkgdir}/opt/lightweight-cloud-connector/"

    # Crear enlace simbólico en /usr/bin
    install -d "${pkgdir}/usr/bin"
    ln -s "/opt/lightweight-cloud-connector/lightweight-cloud-connector" "${pkgdir}/usr/bin/lightweight-cloud-connector"

    # Instalar archivo desktop
    install -d "${pkgdir}/usr/share/applications"
    # Creamos un .desktop adaptado para el sistema
    cat <<EOF > "${pkgdir}/usr/share/applications/lightweight-cloud-connector.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Lightweight Cloud Connector
Comment=Native Google Cloud IAP Connector for Linux
Exec=/usr/bin/lightweight-cloud-connector
Icon=lightweight-cloud-connector
Categories=Development;Network;Utility;
Terminal=false
StartupNotify=true
EOF

    # Licencia (GPL) y NOTICE (copyright + término adicional de marca)
    install -Dm644 LICENSE NOTICE -t "${pkgdir}/usr/share/licenses/${pkgname}/"

    # Instalar icono
    install -d "${pkgdir}/usr/share/icons/hicolor/128x128/apps"
    if [ -f "icon.png" ]; then
        install -m644 "icon.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/lightweight-cloud-connector.png"
    fi
}
