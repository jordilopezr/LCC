FROM almalinux:9
ENV FLUTTER_VERSION="3.41.1"

RUN dnf update -y && \
    dnf install -y epel-release && \
    dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf groupinstall -y "Development Tools" && \
    dnf install -y --allowerasing curl git unzip xz zip mesa-libGLU clang cmake ninja-build pkgconf-pkg-config gtk3-devel rpm-build openssl-devel libsecret-devel jsoncpp-devel lld && \
    dnf clean all

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install flutter_rust_bridge_codegen (pinned to match native/Cargo.toml)
RUN cargo install flutter_rust_bridge_codegen --version 2.11.1

# Install Flutter
RUN curl -L https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz | tar xJ -C /opt
ENV PATH="/opt/flutter/bin:${PATH}"
RUN git config --global --add safe.directory '*'
RUN flutter config --no-analytics --enable-linux-desktop

WORKDIR /workspace
